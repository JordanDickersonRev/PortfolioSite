
<div class="@_dropdownClassName" @onfocusout="HideDropDownItems" tabindex="0">
    <SiteButton SiteButtonClass="@_siteButtonClassName" SiteButtonClicked="DropDownToggleClicked" ShowCaretIcon="@ShowCaretDownIcon" IconClass="@ToggleButtonIconClass" Text="@ToggleButtonText" Disabled="@Disabled"/>
    @if (_showDropDownItems)
    {
        <div class="dropdownItems">
            <ul>
                @DropDownElements
            </ul>
        </div>
    }
    
</div>


